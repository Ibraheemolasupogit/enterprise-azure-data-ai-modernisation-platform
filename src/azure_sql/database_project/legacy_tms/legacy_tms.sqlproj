<Project Sdk="Microsoft.Build.Sql/0.2.5-preview">
  <PropertyGroup>
    <Name>legacy_tms</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <SuppressTSqlWarnings>71558</SuppressTSqlWarnings>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="PreDeployment/**/*.sql" />
    <Build Remove="PostDeployment/**/*.sql" />
    <Build Remove="Security/**/*.sql" />
    <Build Remove="Tests/**/*.sql" />
    <Build Remove="Schemas/dbo.sql" />
    <None Include="Security/**/*.sql" />
    <None Include="Tests/**/*.sql" />
    <None Include="Schemas/dbo.sql" />
  </ItemGroup>
  <ItemGroup>
    <PreDeploy Include="PreDeployment/PreDeployment.sql" />
    <PostDeploy Include="PostDeployment/PostDeployment.sql" />
  </ItemGroup>
</Project>
