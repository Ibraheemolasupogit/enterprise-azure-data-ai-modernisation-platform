<Project Sdk="Microsoft.Build.Sql/0.2.5-preview">
  <PropertyGroup>
    <Name>legacy_tms</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <DefaultCollation>SQL_Latin1_General_CP1_CI_AS</DefaultCollation>
    <SuppressTSqlWarnings>71558</SuppressTSqlWarnings>
  </PropertyGroup>
  <ItemGroup>
    <PreDeploy Include="PreDeployment/PreDeployment.sql" />
    <PostDeploy Include="PostDeployment/ReferenceData.sql" />
  </ItemGroup>
</Project>
